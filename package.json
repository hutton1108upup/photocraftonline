{
  "name": "photocraft-local",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Editable local replica of photocraftonline.com, including the original WebAssembly editor",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/server.mjs",
    "build": "node scripts/build.mjs",
    "build:production": "node scripts/build.mjs --production",
    "preview": "node scripts/server.mjs --production",
    "check": "node scripts/check.mjs",
    "check:production": "node scripts/check-production.mjs",
    "check:analytics": "node scripts/check-analytics.mjs",
    "audit:upload": "node scripts/audit-upload.mjs",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir .local/worker-dry-run"
  },
  "devDependencies": {
    "wrangler": "4.149.0"
  }
}
